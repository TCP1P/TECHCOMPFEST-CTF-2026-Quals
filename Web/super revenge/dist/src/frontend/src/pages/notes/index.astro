---
export const prerender = false;
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { apiBackend, SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getSessionCookie } from '../../middleware';

type NoteListItem = {
	id: string;
	title: string;
	description: string;
	content?: string;
	date?: Date | null;
	heroImage?: string | null;
};

const cookieValue = getSessionCookie(Astro.request.headers.get('cookie'));
let notes: NoteListItem[] = [];
let statusMessage: { kind: 'error' | 'info'; text: string } | null = null;

if (!cookieValue) {
	statusMessage = { kind: 'info', text: 'Sign in to see your notes.' };
} else {
	try {
		const response = await fetch(`${apiBackend}/notes/get-my-notes`, {
			headers: {
				Authorization: `Bearer ${cookieValue}`,
				Accept: 'application/json',
			},
		});
		const payload = await response.json().catch(() => null);
		console.info('Notes fetch response:', payload);
		if (!response.ok) {
			const message =
				typeof payload?.message === 'string' && payload.message.trim()
					? payload.message
					: 'Failed to load notes.';
			statusMessage = { kind: 'error', text: message };
		} else {
			const rawNotes =
				Array.isArray(payload?.payload)
					? payload.payload
					: Array.isArray(payload?.notes)
					? payload.notes
					: Array.isArray(payload)
					? payload
					: [];

			const normalizeId = (value: unknown) =>
				typeof value === 'number'
					? value.toString()
					: typeof value === 'string'
					? value.trim()
					: '';

			notes = rawNotes
				.map((item: Record<string, unknown>) => {
					const id = normalizeId(item.id ?? item._id ?? item.slug);
					if (!id) return null;

					const note: NoteListItem = {
						id,
						title:
							typeof item.title === 'string' && item.title.trim()
								? item.title
								: 'Untitled note',
						description:
							typeof item.description === 'string' && item.description.trim()
								? item.description
								: 'No description provided.',
					};

					if (typeof item.content === 'string') note.content = item.content;

					const dateString =
						(typeof item.updatedAt === 'string' && item.updatedAt) ||
						(typeof item.createdAt === 'string' && item.createdAt);
					if (dateString) {
						const parsed = new Date(dateString);
						if (!Number.isNaN(parsed.valueOf())) note.date = parsed;
					}

					if (typeof item.heroImage === 'string' && item.heroImage.trim()) {
						note.heroImage = item.heroImage.trim();
					}

					return note;
				})
				.filter(Boolean) as NoteListItem[];

			if (!notes.length) {
				statusMessage = { kind: 'info', text: 'No notes yet. Create your first one!' };
			}
		}
	} catch (error) {
		console.error('Notes fetch failed:', error);
		statusMessage = { kind: 'error', text: 'Unable to reach the notes service.' };
	}
}
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700&family=Space+Grotesk:wght@400;500;700&display=swap');

			body {
				margin: 0;
				min-height: 100vh;
				display: flex;
				flex-direction: column;
				background: #050017;
				color: #e6e9ff;
				font-family: 'Space Grotesk', 'Segoe UI', sans-serif;
			}
			main {
				flex: 1;
				width: 100%;
				max-width: 68rem;
				margin: 0 auto;
				padding: 4rem 1.5rem 5rem;
			}
			section {
				background: rgba(12, 10, 40, 0.65);
				backdrop-filter: blur(18px);
				border: 1px solid rgba(155, 232, 255, 0.18);
				border-radius: 24px;
				padding: 2.5rem 2rem;
				box-shadow: 0 20px 60px rgba(8, 4, 35, 0.75);
			}
			ul {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
				gap: 2rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				background: linear-gradient(135deg, rgba(10, 8, 46, 0.85), rgba(52, 22, 113, 0.75));
				border: 1px solid rgba(155, 232, 255, 0.18);
				border-radius: 18px;
				box-shadow: 0 16px 40px rgba(8, 4, 35, 0.65);
				overflow: hidden;
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}
			ul li:first-child {
				grid-column: 1 / -1;
				text-align: left;
			}
			ul li:first-child .title {
				font-size: clamp(2rem, 4vw, 2.8rem);
			}
			ul li:hover {
				transform: translateY(-4px);
				box-shadow: 0 22px 48px rgba(8, 4, 35, 0.78);
			}
			ul li a {
				display: grid;
				gap: 1rem;
				color: inherit;
				padding: 1.75rem;
				text-decoration: none;
			}
			ul li img {
				width: 100%;
				border-radius: 14px;
			}
			.title {
				margin: 0;
				font-family: 'Orbitron', 'Segoe UI', sans-serif;
				color: #ffe066;
				text-shadow: 0 0 12px rgba(255, 224, 102, 0.7);
			}
			.status {
				margin-bottom: 1.5rem;
				padding: 1rem 1.25rem;
				border-radius: 16px;
				font-weight: 500;
				border: 1px solid rgba(155, 232, 255, 0.18);
				background: rgba(12, 10, 40, 0.45);
			}
			.status.error {
				border-color: rgba(255, 99, 132, 0.35);
				background: rgba(255, 99, 132, 0.1);
				color: #ff9aa2;
			}
			.status.info {
				border-color: rgba(155, 232, 255, 0.28);
				background: rgba(155, 232, 255, 0.08);
				color: rgba(155, 232, 255, 0.85);
			}
			.note-description {
				margin: 0;
				color: rgba(205, 212, 255, 0.78);
				font-size: 0.95rem;
				line-height: 1.5;
			}
			.note-meta {
				margin: 0;
				color: rgba(155, 232, 255, 0.65);
				font-size: 0.85rem;
			}

			.empty-state {
				display: grid;
				place-items: center;
				min-height: 10rem;
				text-align: center;
				color: rgba(155, 232, 255, 0.75);
				border: 1px dashed rgba(155, 232, 255, 0.2);
				border-radius: 18px;
				padding: 2rem;
				background: rgba(12, 10, 40, 0.35);
			}
			.actions {
				display: flex;
				justify-content: flex-end;
				margin-bottom: 1.5rem;
			}
			.create-note {
				display: inline-flex;
				align-items: center;
				gap: 0.55rem;
				padding: 0.75rem 1.6rem;
				border-radius: 999px;
				background: linear-gradient(135deg, rgba(255,45,149,0.9), rgba(255,224,102,0.92));
				color: #050017;
				font-weight: 600;
				font-size: 0.95rem;
				text-decoration: none;
				letter-spacing: 0.5px;
				box-shadow: 0 14px 34px rgba(255,45,149,0.35), 0 0 0 1px rgba(255,224,102,0.4) inset;
				transition: transform 0.18s ease, box-shadow 0.18s ease, filter 0.18s ease;
			}
			.create-note:hover,
			.create-note:focus {
				transform: translateY(-3px);
				box-shadow: 0 18px 42px rgba(255,224,102,0.45), 0 0 0 2px rgba(255,45,149,0.5) inset;
				filter: brightness(1.08);
			}
			.create-note:active {
				transform: translateY(0);
				filter: brightness(0.95);
			}
			@media (max-width: 720px) {
				main {
					padding: 3rem 1rem 4rem;
				}
				section {
					padding: 1.75rem 1.25rem;
				}
				ul {
					gap: 1rem;
				}
				ul li {
					grid-column: span 1;
					text-align: center;
				}
				ul li:first-child .title {
					font-size: 2rem;
				}
				ul li a {
					padding: 1.25rem;
				}
				.create-note {
					padding: 0.65rem 1.25rem;
					font-size: 0.85rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<div class="actions">
					<a class="create-note" href="/notes/new">➕ Create note</a>
				</div>
				{statusMessage && (
					<p class={`status ${statusMessage.kind}`}>{statusMessage.text}</p>
				)}
				<ul>
					{notes.length ? (
						notes.map((note) => (
							<li>
								<a href={`/notes/${note.id}/`}>
									{note.heroImage && (
										<img src={note.heroImage} alt="" loading="lazy" decoding="async" />
									)}
									<h4 class="title">{note.title}</h4>
									<p class="note-description">{note.description}</p>
									{note.date && (
										<p class="note-meta">
											<FormattedDate date={note.date} />
										</p>
									)}
								</a>
							</li>
						))
					) : (
						<li class="empty-state">Your notes will appear here once created.</li>
					)}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
