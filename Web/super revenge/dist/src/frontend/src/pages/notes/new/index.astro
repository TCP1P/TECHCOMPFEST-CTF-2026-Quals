---
export const prerender = false;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>Create Note • Super Revenge</title>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<style>
			@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700&family=Space+Grotesk:wght@400;500;700&display=swap');

			:root {
				color-scheme: dark;
			}
			body {
				margin: 0;
				min-height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 2rem;
				background: radial-gradient(circle at 20% 20%, rgba(255, 45, 149, 0.25), transparent 55%),
					radial-gradient(circle at 80% 0%, rgba(155, 232, 255, 0.2), transparent 45%),
					#050017;
				font-family: 'Space Grotesk', 'Segoe UI', sans-serif;
				color: #e6e9ff;
			}
			.modal {
				width: min(38rem, 100%);
				background: rgba(12, 10, 40, 0.92);
				border-radius: 24px;
				border: 1px solid rgba(155, 232, 255, 0.25);
				box-shadow: 0 24px 64px rgba(8, 4, 35, 0.85);
				backdrop-filter: blur(18px);
				padding: 2.5rem;
				position: relative;
			}
			h1 {
				margin: 0 0 1.5rem;
				font-family: 'Orbitron', 'Segoe UI', sans-serif;
				font-size: clamp(1.8rem, 4vw, 2.3rem);
				color: #ffe066;
				text-shadow: 0 0 12px rgba(255, 224, 102, 0.7);
			}
			form {
				display: grid;
				gap: 1.25rem;
			}
			label {
				display: grid;
				gap: 0.5rem;
				font-weight: 500;
				color: rgba(155, 232, 255, 0.9);
			}
			input,
			textarea {
				border-radius: 12px;
				border: 1px solid rgba(155, 232, 255, 0.25);
				background: rgba(8, 6, 28, 0.9);
				color: inherit;
				padding: 0.85rem 1rem;
				font: inherit;
				resize: vertical;
				min-height: 3rem;
				outline: none;
				transition: border-color 0.2s ease, box-shadow 0.2s ease;
			}
			input:focus,
			textarea:focus {
				border-color: rgba(255, 224, 102, 0.85);
				box-shadow: 0 0 0 3px rgba(255, 224, 102, 0.25);
			}
			.actions {
				display: flex;
				justify-content: flex-end;
				gap: 0.75rem;
				margin-top: 0.5rem;
			}
			.button {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: 0.4rem;
				padding: 0.8rem 1.6rem;
				border-radius: 999px;
				border: none;
				font-weight: 600;
				font-size: 0.95rem;
				cursor: pointer;
				text-decoration: none;
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}
			.button.secondary {
				background: rgba(155, 232, 255, 0.1);
				color: rgba(155, 232, 255, 0.9);
			}
			.button.primary {
				background: linear-gradient(135deg, rgba(255, 45, 149, 0.85), rgba(255, 224, 102, 0.85));
				color: #050017;
				box-shadow: 0 14px 32px rgba(255, 45, 149, 0.35);
			}
			.button:hover {
				transform: translateY(-2px);
			}
			.button.primary:hover {
				box-shadow: 0 18px 40px rgba(255, 224, 102, 0.45);
			}
			.close {
				position: absolute;
				top: 1rem;
				right: 1rem;
				color: rgba(155, 232, 255, 0.7);
				text-decoration: none;
				font-size: 1.5rem;
				line-height: 1;
			}
			@media (max-width: 640px) {
				body {
					padding: 1.25rem;
				}
				.modal {
					padding: 2rem 1.5rem;
				}
			}
		</style>
	</head>
	<body>
		<div class="modal">
			<a class="close" href="/notes" aria-label="Back to notes">✕</a>
			<h1>Create a new note</h1>
			<form method="post" action="/api/notes/create">
				<label>
					Title
					<input name="title" type="text" placeholder="Enter note title" required />
				</label>
				<label>
					Description
					<textarea name="description" rows="3" placeholder="Add a short description..." required></textarea>
				</label>
				<label>
					Content
					<textarea name="content" rows="6" placeholder="Write your note..." required></textarea>
				</label>
				<div class="actions">
					<a class="button secondary" href="/notes">Cancel</a>
					<button class="button primary" type="submit">Create note</button>
				</div>
			</form>
		</div>
	</body>
</html>
