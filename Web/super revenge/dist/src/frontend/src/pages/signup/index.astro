---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Sign Up · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700&family=Space+Grotesk:wght@400;500;700&display=swap');

			body {
				margin: 0;
				min-height: 100vh;
				display: flex;
				flex-direction: column;
				background: radial-gradient(circle at 20% 20%, rgba(255, 45, 149, 0.25), transparent 55%),
					radial-gradient(circle at 80% 0%, rgba(155, 232, 255, 0.2), transparent 45%),
					#050017;
				color: #e6e9ff;
				font-family: 'Space Grotesk', 'Segoe UI', sans-serif;
			}
			main {
				flex: 1;
				display: grid;
				place-items: center;
				padding: 4rem 1.5rem 5rem;
				position: relative;
				overflow: hidden;
			}
			main::before,
			main::after {
				content: '';
				position: absolute;
				inset: 0;
				background: radial-gradient(ellipse at top, rgba(255, 45, 149, 0.28), transparent 55%),
					radial-gradient(ellipse at bottom, rgba(155, 232, 255, 0.22), transparent 50%);
				filter: blur(46px);
				opacity: 0.75;
				animation: aurora-flow 18s ease-in-out infinite alternate;
				z-index: 0;
			}
			main::after {
				animation-delay: 5s;
				mix-blend-mode: screen;
			}
			.panel {
				width: min(32rem, 100%);
				padding: 3.25rem 2.75rem;
				border-radius: 28px;
				background: rgba(12, 10, 40, 0.72);
				border: 1px solid rgba(155, 232, 255, 0.22);
				box-shadow: 0 26px 68px rgba(8, 4, 35, 0.78);
				backdrop-filter: blur(20px);
				display: grid;
				gap: 2.2rem;
				position: relative;
				z-index: 1;
				overflow: hidden;
				animation: panel-float 11s ease-in-out infinite;
			}
			.panel-header {
				display: grid;
				gap: 0.75rem;
				text-align: center;
			}
			.panel-header h1 {
				margin: 0;
				font-family: 'Orbitron', 'Segoe UI', sans-serif;
				text-transform: uppercase;
				letter-spacing: 0.14em;
				color: #ffe066;
				text-shadow: 0 0 18px rgba(255, 224, 102, 0.85);
			}
			.panel-header p {
				margin: 0;
				color: rgba(230, 233, 255, 0.78);
			}
			form {
				display: grid;
				gap: 1.35rem;
			}
			label {
				display: grid;
				gap: 0.5rem;
				font-size: 0.9rem;
				color: rgba(230, 233, 255, 0.8);
				text-transform: uppercase;
				letter-spacing: 0.08em;
			}
			input {
				height: 3rem;
				padding: 0 1.1rem;
				border-radius: 999px;
				border: 1px solid rgba(155, 232, 255, 0.35);
				background: rgba(5, 0, 23, 0.55);
				color: #e6e9ff;
				font-size: 1rem;
				transition: border-color 0.2s ease, box-shadow 0.2s ease;
			}
			input::placeholder {
				color: rgba(230, 233, 255, 0.45);
			}
			input:focus {
				outline: none;
				border-color: rgba(255, 224, 102, 0.62);
				box-shadow: 0 0 0 3px rgba(255, 224, 102, 0.25);
			}
			.actions {
				display: grid;
				gap: 1rem;
			}
			button {
				padding: 1rem 1.8rem;
				border: none;
				border-radius: 999px;
				background: linear-gradient(135deg, #ff2d95, #ffe066, #9be8ff);
				background-size: 240% 240%;
				animation: button-spectrum 4.5s ease infinite, button-breathe 7s ease-in-out infinite;
				color: #050017;
				font-family: 'Orbitron', 'Segoe UI', sans-serif;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				cursor: pointer;
				box-shadow: 0 16px 38px rgba(255, 45, 149, 0.5);
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}
			button:hover {
				transform: translateY(-3px) scale(1.02);
				box-shadow: 0 22px 48px rgba(155, 232, 255, 0.5);
			}
			button:focus-visible {
				outline: 2px solid rgba(255, 224, 102, 0.85);
				outline-offset: 4px;
			}
			.guardian-note {
				font-size: 0.85rem;
				color: rgba(230, 233, 255, 0.65);
				text-align: center;
				line-height: 1.6;
			}
			.guardian-note a {
				color: #9be8ff;
				text-decoration: none;
				text-shadow: 0 0 8px rgba(155, 232, 255, 0.6);
				transition: color 0.2s ease, text-shadow 0.2s ease;
			}
			.guardian-note a:hover {
				color: #ffe066;
				text-shadow: 0 0 12px rgba(255, 224, 102, 0.85);
			}
			.toast-stack {
				position: fixed;
				top: 1.5rem;
				right: 1.5rem;
				display: grid;
				gap: 0.75rem;
				z-index: 10;
			}
			.toast {
				min-width: 16rem;
				padding: 0.85rem 1.2rem;
				border-radius: 14px;
				background: rgba(12, 10, 40, 0.88);
				border: 1px solid rgba(155, 232, 255, 0.35);
				box-shadow: 0 18px 44px rgba(8, 4, 35, 0.7);
				color: #e6e9ff;
				font-size: 0.95rem;
				display: flex;
				align-items: center;
				gap: 0.75rem;
				backdrop-filter: blur(16px);
				animation: toast-slide-in 0.35s ease forwards;
			}
			.toast.toast-success {
				border-color: rgba(255, 224, 102, 0.6);
				text-shadow: 0 0 8px rgba(255, 224, 102, 0.6);
			}
			.toast.toast-error {
				border-color: rgba(255, 45, 149, 0.6);
				text-shadow: 0 0 8px rgba(255, 45, 149, 0.6);
			}
			@keyframes aurora-flow {
				0% {
					transform: translate3d(-9%, -7%, 0) scale(1);
					opacity: 0.62;
				}
				100% {
					transform: translate3d(10%, 9%, 0) scale(1.18);
					opacity: 0.85;
				}
			}
			@keyframes outline-spin {
				to {
					transform: rotate(360deg);
				}
			}
			@keyframes panel-float {
				0%,
				100% {
					transform: translateY(0) scale(1);
				}
				50% {
					transform: translateY(-7px) scale(1.01);
				}
			}
			@keyframes button-spectrum {
				0% {
					background-position: 0% 50%;
					box-shadow: 0 16px 38px rgba(255, 45, 149, 0.5);
				}
				50% {
					background-position: 100% 50%;
					box-shadow: 0 22px 48px rgba(155, 232, 255, 0.5);
				}
				100% {
					background-position: 0% 50%;
					box-shadow: 0 16px 38px rgba(255, 224, 102, 0.5);
				}
			}
			@keyframes button-breathe {
				0%,
				100% {
					transform: translateY(0);
				}
				50% {
					transform: translateY(-4px) scale(1.015);
				}
			}
			@keyframes toast-slide-in {
				from {
					opacity: 0;
					transform: translateX(20px) translateY(-10px);
				}
				to {
					opacity: 1;
					transform: translateX(0) translateY(0);
				}
			}
			@media (max-width: 720px) {
				main {
					padding: 3rem 1rem 4rem;
				}
				.panel {
					padding: 2.75rem 1.85rem;
				}
				input {
					height: 2.9rem;
				}
				.toast-stack {
					top: auto;
					right: 0.75rem;
					left: 0.75rem;
					bottom: 1.5rem;
				}
				.toast {
					min-width: auto;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="panel">
				<div class="panel-header">
					<h1>Request Clearance</h1>
					<p>Establish your Super Note credentials and link directly to Mission Control support.</p>
				</div>
				<form method="post" action="/api/signup" data-signup-form>
					<label>
					<span>Full Name</span>
					<input type="text" name="name" placeholder="Commander Nova" autocomplete="name" required />
					</label>
					<label>
						<span>Call Sign (Email)</span>
						<input type="email" name="email" placeholder="nova@supernote.io" autocomplete="email" required />
					</label>
					<label>
						<span>Access Key</span>
						<input type="password" name="password" placeholder="Create a secure key" autocomplete="new-password" minlength="8" required />
					</label>
					<label>
						<span>Confirm Key</span>
						<input type="password" name="confirmPassword" placeholder="Re-enter your key" autocomplete="new-password" minlength="8" required />
					</label>
					<div class="actions">
						<button type="submit">Activate Clearance</button>
					</div>
				</form>
				<p class="guardian-note">
					By activating clearance you agree to our <a href="/terms">Operational Terms</a> and
					<a href="/privacy">Signal Privacy Policy</a>. Already trusted? <a href="/signin">Initiate link</a>.
				</p>
			</section>
		</main>
		<div class="toast-stack" aria-live="polite" aria-atomic="true"></div>
		<Footer />
		<script type="module" src="/scripts/signup.js"></script>
	</body>
</html>
