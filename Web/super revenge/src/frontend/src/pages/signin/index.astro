---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Sign In · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700&family=Space+Grotesk:wght@400;500;700&display=swap');

			body {
				margin: 0;
				min-height: 100vh;
				display: flex;
				flex-direction: column;
				background: radial-gradient(circle at 20% 20%, rgba(255, 45, 149, 0.25), transparent 55%),
					radial-gradient(circle at 80% 0%, rgba(155, 232, 255, 0.2), transparent 45%),
					#050017;
				color: #e6e9ff;
				font-family: 'Space Grotesk', 'Segoe UI', sans-serif;
			}
			main {
				flex: 1;
				display: grid;
				place-items: center;
				padding: 4rem 1.5rem 5rem;
				position: relative;
				overflow: hidden;
			}
			main::before,
			main::after {
				content: '';
				position: absolute;
				inset: 0;
				background: radial-gradient(ellipse at top, rgba(255, 45, 149, 0.25), transparent 55%),
					radial-gradient(ellipse at bottom, rgba(155, 232, 255, 0.2), transparent 50%);
				filter: blur(40px);
				opacity: 0.7;
				animation: aurora-shift 16s ease-in-out infinite alternate;
				z-index: 0;
			}
			main::after {
				animation-delay: 4s;
				mix-blend-mode: screen;
			}
			.panel {
				width: min(28rem, 100%);
				padding: 3rem 2.5rem;
				border-radius: 26px;
				background: rgba(12, 10, 40, 0.7);
				border: 1px solid rgba(155, 232, 255, 0.22);
				box-shadow: 0 24px 64px rgba(8, 4, 35, 0.78);
				backdrop-filter: blur(18px);
				display: grid;
				gap: 2rem;
				position: relative;
				z-index: 1;
				overflow: hidden;
				animation: panel-float 10s ease-in-out infinite;
			}
			
			.panel-header {
				display: grid;
				gap: 0.75rem;
				text-align: center;
			}
			.panel-header h1 {
				margin: 0;
				font-family: 'Orbitron', 'Segoe UI', sans-serif;
				text-transform: uppercase;
				letter-spacing: 0.12em;
				color: #ffe066;
				text-shadow: 0 0 16px rgba(255, 224, 102, 0.8);
			}
			.panel-header p {
				margin: 0;
				color: rgba(230, 233, 255, 0.75);
			}
			form {
				display: grid;
				gap: 1.25rem;
			}
			label {
				display: grid;
				gap: 0.45rem;
				font-size: 0.9rem;
				color: rgba(230, 233, 255, 0.78);
				text-transform: uppercase;
				letter-spacing: 0.08em;
			}
			input {
				height: 3rem;
				padding: 0 1rem;
				border-radius: 999px;
				border: 1px solid rgba(155, 232, 255, 0.35);
				background: rgba(5, 0, 23, 0.55);
				color: #e6e9ff;
				font-size: 1rem;
				transition: border-color 0.2s ease, box-shadow 0.2s ease;
			}
			input::placeholder {
				color: rgba(230, 233, 255, 0.45);
			}
			input:focus {
				outline: none;
				border-color: rgba(255, 224, 102, 0.6);
				box-shadow: 0 0 0 3px rgba(255, 224, 102, 0.25);
			}
			.actions {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				flex-wrap: wrap;
			}
			button {
				flex: 1;
				min-width: 10rem;
				padding: 0.95rem 1.6rem;
				border: none;
				border-radius: 999px;
				background: linear-gradient(135deg, #ff2d95, #ffe066, #9be8ff);
				background-size: 220% 220%;
				animation: button-spectrum 4s ease infinite, button-breathe 6s ease-in-out infinite, button-drift 10s ease-in-out infinite;
				color: #050017;
				font-family: 'Orbitron', 'Segoe UI', sans-serif;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				cursor: pointer;
				box-shadow: 0 14px 34px rgba(255, 45, 149, 0.45);
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}
			button:hover {
				transform: translateY(-2px) scale(1.02);
				box-shadow: 0 20px 44px rgba(255, 224, 102, 0.55);
			}
			button:focus-visible {
				outline: 2px solid rgba(255, 224, 102, 0.8);
				outline-offset: 4px;
			}
			.secondary-link {
				display: inline-flex;
				justify-content: center;
				width: 100%;
				color: rgba(230, 233, 255, 0.75);
				margin-top: -0.5rem;
			}
			.secondary-link a {
				color: #9be8ff;
				text-decoration: none;
				margin-left: 0.4rem;
				text-shadow: 0 0 8px rgba(155, 232, 255, 0.6);
			}
			.secondary-link a:hover {
				color: #ffe066;
			}
			.toast-stack {
				position: fixed;
				top: 1.5rem;
				right: 1.5rem;
				display: grid;
				gap: 0.75rem;
				z-index: 10;
			}
			.toast {
				min-width: 16rem;
				padding: 0.85rem 1.2rem;
				border-radius: 14px;
				background: rgba(12, 10, 40, 0.88);
				border: 1px solid rgba(155, 232, 255, 0.35);
				box-shadow: 0 18px 44px rgba(8, 4, 35, 0.7);
				color: #e6e9ff;
				font-size: 0.95rem;
				display: flex;
				align-items: center;
				gap: 0.75rem;
				backdrop-filter: blur(16px);
				animation: toast-slide-in 0.35s ease forwards;
			}
			.toast.toast-success {
				border-color: rgba(255, 224, 102, 0.6);
				text-shadow: 0 0 8px rgba(255, 224, 102, 0.6);
			}
			.toast.toast-error {
				border-color: rgba(255, 45, 149, 0.6);
				text-shadow: 0 0 8px rgba(255, 45, 149, 0.6);
			}
			@keyframes button-spectrum {
				0% {
					background-position: 0% 50%;
					box-shadow: 0 14px 34px rgba(255, 45, 149, 0.45);
				}
				50% {
					background-position: 100% 50%;
					box-shadow: 0 20px 44px rgba(155, 232, 255, 0.45);
				}
				100% {
					background-position: 0% 50%;
					box-shadow: 0 14px 34px rgba(255, 224, 102, 0.45);
				}
			}
			@keyframes button-breathe {
				0% {
					transform: translateY(0);
				}
				100% {
					transform: translateY(-3px) scale(1.01);
				}
			}
			@keyframes aurora-shift {
				0% {
					transform: translate3d(-8%, -6%, 0) scale(1);
					opacity: 0.6;
				}
				100% {
					transform: translate3d(8%, 6%, 0) scale(1.1);
					opacity: 0.85;
				}
			}
		
			@keyframes panel-float {
				0%,
				100% {
					transform: translateY(0) scale(1);
				}
				50% {
					transform: translateY(-6px) scale(1.01);
				}
			}
			@keyframes button-drift {
				0%,
				100% {
					transform: translateY(0) scale(1);
				}
				50% {
					transform: translateY(-4px) scale(1.015);
				}
			}
			@keyframes toast-slide-in {
				from {
					opacity: 0;
					transform: translateX(20px) translateY(-10px);
				}
				to {
					opacity: 1;
					transform: translateX(0) translateY(0);
				}
			}
			@media (max-width: 720px) {
				main {
					padding: 3rem 1rem 4rem;
				}
				.panel {
					padding: 2.5rem 1.75rem;
				}
				.actions {
					flex-direction: column;
				}
				button {
					width: 100%;
				}
				.toast-stack {
					top: auto;
					right: 0.75rem;
					left: 0.75rem;
					bottom: 1.5rem;
				}
				.toast {
					min-width: auto;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="panel">
				<div class="panel-header">
					<h1>Mission Access</h1>
					<p>Authenticate to rejoin command operations and sync with the latest transmissions.</p>
				</div>
				<form method="post" action="/api/signin" data-signin-form>
					<label>
						<span>Signal ID</span>
						<input type="email" name="email" placeholder="pilot@mission.control" required />
					</label>
					<label>
						<span>Access Key</span>
						<input type="password" name="password" placeholder="••••••••" required />
					</label>
					<div class="actions">
						<button type="submit">Initiate Link</button>
					</div>
				</form>
				<div class="secondary-link">
					New recruit? <a href="/signup">Request access credentials</a>
				</div>
			</section>
		</main>
		<div class="toast-stack" aria-live="polite" aria-atomic="true"></div>
		<Footer />
		<script type="module" src="/scripts/signin.js"></script>
	</body>
</html>
